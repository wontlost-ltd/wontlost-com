---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/footer/Footer.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { aguiPlans, buyHref, salesEmail } from '../data/agui-pricing';

const version = '0.1.2';
const openVersion = '0.1.1';

const tiers = [
  {
    name: 'Open source',
    price: 'Free, Apache 2.0',
    artifact: `com.wontlost:agui-vaadin:${openVersion}`,
    items: [
      'AgUiChat component: Markdown, tool-call cards, thinking blocks, shared state',
      'The AG-UI event model and a Spring SSE endpoint',
      'Spring AI adapter: one bean turns a ChatModel into an agent',
      'Frontend tools, stop and regenerate, copy and feedback, i18n, light and dark',
      'Works with any AG-UI backend: LangGraph, Pydantic AI, Mastra, CopilotKit',
    ],
  },
  {
    name: 'Pro',
    price: 'Per developer',
    artifact: `com.wontlost:agui-pro-*:${version}`,
    items: [
      'Conversations: store, sidebar with search and rename, restores the agent state',
      'Audit trail: every message, run, tool call and feedback, with an explorer component',
      'State panel: renders shared state by shape with change highlighting',
      'JDBC stores for PostgreSQL, MySQL, H2 and Oracle with automatic schema',
      'Offline license keys, nothing phones home',
    ],
  },
  {
    name: 'Enterprise',
    price: 'Per application',
    artifact: `com.wontlost:agui-ee-*:${version}`,
    items: [
      'Identity from Spring Security, tenant extraction, tool authorization, CSRF',
      'Approval policies: which tools need a human, quorum, expiry, approval inbox',
      'Metering: tokens and cost per tenant, actor and agent; quotas per day and month',
      'Governance: PII redaction, retention, legal hold, CSV, JSON and Markdown exports',
      'Observability with Micrometer metrics and traces; one-page console',
    ],
  },
];

const steps = [
  { step: '1', title: 'Try it', desc: 'Add the Pro or Enterprise dependency. Development mode runs a 30-day trial without a key; production mode never blocks, it shows a banner.' },
  { step: '2', title: 'Order', desc: 'Pick a plan below. The button opens an order email with the three things a key needs: licensee, invoice email, number of developers.' },
  { step: '3', title: 'Pay', desc: 'You receive an invoice with a card payment link. Bank transfer on request for Business and Enterprise.' },
  { step: '4', title: 'Get the key', desc: 'Within one business day you receive a signed key. Put it in AGUI_PRO_LICENSE or ~/.agui-pro/license.key and the banner and warnings are gone.' },
];

const faqs = [
  {
    q: 'Who needs a key?',
    a: 'Developers do, deployed applications do not. It is the model Vaadin uses for its commercial components: a subscription per developer seat, unlimited deployments and end users.',
  },
  {
    q: 'What happens without a key?',
    a: 'In development mode each Pro feature warns once and works for 30 days, then throws. In production mode the application always runs; it logs one error and shows a persistent "unlicensed build" banner at the bottom of every page.',
  },
  {
    q: 'What happens when my subscription ends?',
    a: 'Deployed applications keep running with the expired key. Renewal is about continuing to develop and upgrade, never about keeping production alive.',
  },
  {
    q: 'Does the key phone home?',
    a: 'No. Keys are Ed25519-signed and verified offline against a public key embedded in the library.',
  },
  {
    q: 'Open source or education?',
    a: `Free keys for open-source projects and teaching. Email ${salesEmail} with a link to the project or course.`,
  },
  {
    q: 'Which databases and versions?',
    a: 'Vaadin 25.2 and later, Java 21 and later, Spring Boot 4 and Spring AI 2. The JDBC stores run one contract test suite against PostgreSQL 16, MySQL 8.4, Oracle Free 23 and H2.',
  },
];
---

<BaseLayout
  title="AG-UI for Vaadin — AI chat component, Pro persistence and Enterprise governance | wontlost"
  description="AG-UI protocol chat for Vaadin Flow. Open-source component on Maven Central; Pro adds conversations, audit trail and state panel; Enterprise adds identity, approvals, metering, governance and observability. Per-developer licensing, unlimited deployments."
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-br from-white via-primary-50/30 to-white">
      <Container>
        <div class="section-padding">
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            <div class="animate-fade-in-up">
              <a href="/" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-primary-500 transition-colors mb-6">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to wontlost.com
              </a>

              <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary-50 text-primary-600 text-sm font-medium rounded-full mb-6">
                <span class="w-1.5 h-1.5 bg-primary-500 rounded-full"></span>
                Open-source core, commercial Pro and Enterprise
              </div>

              <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold text-gray-900 tracking-tight leading-tight">
                AG-UI
                <span class="text-primary-500"> for Vaadin</span>
              </h1>

              <p class="mt-6 text-lg text-gray-600 leading-relaxed max-w-lg">
                Structured agent events streamed straight to the browser. Tool calls, thinking, shared state and a stop button, without <code class="text-sm bg-gray-100 px-1 rounded">@Push</code> or the UI lock. Add persistence, audit and governance when the assistant leaves the prototype stage.
              </p>

              <div class="mt-8 flex flex-wrap gap-4">
                <Button href="https://agui.wontlost.com" variant="primary" size="lg">
                  Live demo
                </Button>
                <Button href="https://agui-pro.wontlost.com" variant="secondary" size="lg">
                  Pro and Enterprise demo
                </Button>
              </div>

              <div class="mt-10 flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-gray-500">
                {['Apache 2.0 core', 'Maven Central', 'Vaadin 25, Java 21', 'Spring AI 2'].map((item) => (
                  <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {item}
                  </div>
                ))}
              </div>
            </div>

            <!-- 右侧：三行代码 + 事件流示意 -->
            <div class="relative animate-fade-in-up-delay-1 hidden lg:block">
              <div class="relative w-full max-w-lg mx-auto">
                <div class="absolute inset-0 bg-gradient-to-br from-primary-100 to-primary-50 rounded-3xl rotate-3"></div>
                <div class="relative bg-white rounded-3xl shadow-xl border border-gray-100 -rotate-1 p-6">
                  <div class="flex gap-2 mb-3">
                    <div class="w-3 h-3 rounded-full bg-red-400"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                    <div class="w-3 h-3 rounded-full bg-green-400"></div>
                  </div>
                  <div class="text-xs text-gray-400 mb-4 font-mono">OrderDeskView.java</div>
                  <div class="bg-gray-900 rounded-lg p-4 font-mono text-xs text-gray-300 space-y-1">
                    <div><span class="text-blue-400">AgUiChat</span> chat = <span class="text-purple-400">new</span> <span class="text-blue-400">AgUiChat</span>(<span class="text-green-400">"/agui/orderDesk"</span>);</div>
                    <div>chat.setSizeFull();</div>
                    <div>add(chat);</div>
                    <div class="pt-2 text-gray-500">// Pro: one call binds conversations and audit to the user</div>
                    <div><span class="text-blue-400">SecuredBinding</span>.bind(chat, resolver, store, trail, <span class="text-green-400">"orderDesk"</span>);</div>
                  </div>
                  <div class="mt-4 space-y-2">
                    {[
                      ['RUN_STARTED', 'thread t-1041', 'bg-gray-100 text-gray-600'],
                      ['TOOL_CALL', 'lookupOrder({"id":"A-1001"})', 'bg-amber-50 text-amber-700'],
                      ['STATE_DELTA', '/orders/A-1001/eta → "Thu"', 'bg-primary-50 text-primary-700'],
                      ['TEXT_MESSAGE', 'Order A-1001 ships Thursday…', 'bg-green-50 text-green-700'],
                    ].map(([kind, detail, cls]) => (
                      <div class="flex items-center gap-3 text-xs">
                        <span class:list={['px-2 py-0.5 rounded font-mono font-medium', cls]}>{kind}</span>
                        <span class="text-gray-500 truncate">{detail}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <!-- Tiers -->
    <section id="editions" class="section-padding section-bg-alt">
      <Container>
        <div class="text-center mb-12 lg:mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-900 tracking-tight">
            Three editions, one component
          </h2>
          <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
            Every module is a separate Maven artifact and is auto-configured by Spring Boot. Start with the open-source add-on and add what you need.
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-6 lg:gap-8">
          {tiers.map((tier, index) => (
            <div class:list={[
              'bg-white rounded-xl p-6 lg:p-8 border shadow-sm flex flex-col',
              index === 1 ? 'border-primary-200 ring-1 ring-primary-100' : 'border-gray-100',
            ]}>
              <h3 class="text-xl font-heading font-bold text-gray-900">{tier.name}</h3>
              <p class="text-sm text-primary-500 font-medium mt-1">{tier.price}</p>
              <code class="mt-4 block text-xs bg-gray-50 border border-gray-100 rounded-md px-3 py-2 text-gray-700 break-all">{tier.artifact}</code>
              <ul class="mt-5 space-y-2.5 text-sm text-gray-600 leading-relaxed">
                {tier.items.map((item) => (
                  <li class="flex gap-2">
                    <svg class="w-4 h-4 mt-1 text-green-500 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="mt-10 grid md:grid-cols-2 gap-6">
          <div class="bg-gray-900 rounded-xl p-5 font-mono text-xs text-gray-300">
            <div class="text-gray-500 mb-2">// pom.xml — open source</div>
            <div>&lt;dependency&gt;</div>
            <div class="pl-4">&lt;groupId&gt;com.wontlost&lt;/groupId&gt;</div>
            <div class="pl-4">&lt;artifactId&gt;agui-vaadin&lt;/artifactId&gt;</div>
            <div class="pl-4">&lt;version&gt;{openVersion}&lt;/version&gt;</div>
            <div>&lt;/dependency&gt;</div>
          </div>
          <div class="bg-gray-900 rounded-xl p-5 font-mono text-xs text-gray-300">
            <div class="text-gray-500 mb-2">// pom.xml — Pro conversations (same for agui-pro-audit, agui-pro-state, agui-ee-*)</div>
            <div>&lt;dependency&gt;</div>
            <div class="pl-4">&lt;groupId&gt;com.wontlost&lt;/groupId&gt;</div>
            <div class="pl-4">&lt;artifactId&gt;agui-pro-conversations&lt;/artifactId&gt;</div>
            <div class="pl-4">&lt;version&gt;{version}&lt;/version&gt;</div>
            <div>&lt;/dependency&gt;</div>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-4 justify-center text-sm">
          <a href="https://vaadin.com/directory/component/aguivaadin" class="text-primary-500 hover:text-primary-600 font-medium">AgUiVaadin on Vaadin Directory →</a>
          <a href="https://github.com/wontlost-ltd/vaadin-agui" class="text-primary-500 hover:text-primary-600 font-medium">Source and docs on GitHub →</a>
          <a href="https://central.sonatype.com/search?q=com.wontlost+agui" class="text-primary-500 hover:text-primary-600 font-medium">Artifacts on Maven Central →</a>
        </div>
      </Container>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="section-padding">
      <Container>
        <div class="text-center mb-12 lg:mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-900 tracking-tight">
            Pricing
          </h2>
          <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
            Annual subscription per developer seat. Deployments and end users are unlimited. Prices in USD, excluding tax.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {aguiPlans.map((plan) => (
            <div class:list={[
              'relative bg-white rounded-xl p-6 border shadow-sm flex flex-col',
              plan.highlighted ? 'border-primary-500 shadow-lg shadow-primary-500/10' : 'border-gray-100',
            ]}>
              {plan.highlighted && (
                <span class="absolute -top-3 left-6 px-3 py-0.5 bg-primary-500 text-white text-xs font-semibold rounded-full">Most teams</span>
              )}
              <h3 class="text-lg font-heading font-bold text-gray-900">{plan.name}</h3>
              <p class="text-sm text-gray-500 mt-1">{plan.seats}</p>
              <div class="mt-5">
                <span class="text-3xl font-heading font-bold text-gray-900">{plan.price}</span>
                <span class="text-sm text-gray-500 ml-1">{plan.period}</span>
              </div>
              <p class="mt-3 text-sm text-gray-600">{plan.description}</p>
              <ul class="mt-5 space-y-2 text-sm text-gray-600 flex-1">
                {plan.features.map((f) => (
                  <li class="flex gap-2">
                    <svg class="w-4 h-4 mt-0.5 text-green-500 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <Button href={buyHref(plan)} variant={plan.highlighted ? 'primary' : 'secondary'} size="md" class="mt-6 w-full">
                {plan.price === 'Custom' ? 'Talk to us' : `Buy ${plan.name}`}
              </Button>
            </div>
          ))}
        </div>

        <p class="mt-8 text-center text-sm text-gray-500">
          Free keys for open-source projects and education. The open-source add-on is on <a href="https://vaadin.com/directory/component/aguivaadin" class="text-primary-500 hover:text-primary-600">Vaadin Directory</a> and Maven Central; Pro and Enterprise ship from Maven Central too, the key only unlocks development.
        </p>
      </Container>
    </section>

    <!-- How to buy -->
    <section id="how-to-buy" class="section-padding section-bg-alt">
      <Container>
        <div class="text-center mb-12 lg:mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-900 tracking-tight">
            From trial to key in four steps
          </h2>
          <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
            No account, no portal. The library is on Maven Central for everyone; the key is what you buy.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {steps.map((item) => (
            <div class="relative bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
              <div class="w-8 h-8 bg-primary-500 text-white rounded-full flex items-center justify-center font-heading font-bold text-sm mb-4">
                {item.step}
              </div>
              <h3 class="font-heading font-semibold text-gray-900 mb-2">{item.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 bg-white rounded-xl border border-gray-100 shadow-sm p-6 lg:p-8 grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="font-heading font-semibold text-gray-900 mb-3">Where the key goes</h3>
            <ul class="text-sm text-gray-600 space-y-1.5 font-mono">
              <li>agui.pro.license=AGUI1.… <span class="font-sans text-gray-400">(application.properties)</span></li>
              <li>AGUI_PRO_LICENSE=AGUI1.… <span class="font-sans text-gray-400">(environment)</span></li>
              <li>-Dagui.pro.license=AGUI1.… <span class="font-sans text-gray-400">(JVM)</span></li>
              <li>~/.agui-pro/license.key <span class="font-sans text-gray-400">(developer machine)</span></li>
            </ul>
          </div>
          <div>
            <h3 class="font-heading font-semibold text-gray-900 mb-3">With and without a key</h3>
            <table class="w-full text-sm text-left">
              <thead class="text-gray-500">
                <tr><th class="pb-2 font-medium"></th><th class="pb-2 font-medium">Valid key</th><th class="pb-2 font-medium">No key</th></tr>
              </thead>
              <tbody class="text-gray-600">
                <tr class="border-t border-gray-100"><td class="py-2 pr-3 font-medium text-gray-900">Development</td><td class="py-2 pr-3">works</td><td class="py-2">30-day trial, then blocked</td></tr>
                <tr class="border-t border-gray-100"><td class="py-2 pr-3 font-medium text-gray-900">Production</td><td class="py-2 pr-3">works, also after expiry</td><td class="py-2">works, with a banner</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </Container>
    </section>

    <!-- FAQ -->
    <section class="section-padding">
      <Container>
        <div class="text-center mb-12 lg:mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-900 tracking-tight">
            Questions
          </h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
          {faqs.map((f) => (
            <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
              <h3 class="font-heading font-semibold text-gray-900 mb-2">{f.q}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-600 via-primary-500 to-primary-600"></div>
      <Container>
        <div class="relative section-padding text-center">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white tracking-tight">
            See it running before you decide
          </h2>
          <p class="mt-4 text-lg text-primary-50 max-w-2xl mx-auto">
            Atlas Order Desk runs the open-source add-on with six agents on mock data. The support desk demo runs every Pro and Enterprise module: log in as alice, bob or carol, password pw.
          </p>
          <div class="mt-8 flex flex-wrap gap-4 justify-center">
            <Button href="https://agui.wontlost.com" variant="outline" size="lg">Open-source demo</Button>
            <Button href="https://agui-pro.wontlost.com" variant="outline" size="lg">Pro and Enterprise demo</Button>
            <Button href={`mailto:${salesEmail}?subject=${encodeURIComponent('AG-UI for Vaadin')}`} variant="outline" size="lg">Email us</Button>
          </div>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
</BaseLayout>
