---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/footer/Footer.astro';
import HeroSection from '../components/home/HeroSection.astro';
import TrustBar from '../components/home/TrustBar.astro';
import Products from '../components/home/Products.astro';
import ServicesGrid from '../components/home/ServicesGrid.astro';
import CaseStudy from '../components/home/CaseStudy.astro';
import WhyChooseUs from '../components/home/WhyChooseUs.astro';
import TechStack from '../components/home/TechStack.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Process from '../components/home/Process.astro';
import CTASection from '../components/home/CTASection.astro';
---

<BaseLayout
  title="Developer Tools & Cloud Platforms | wontlost"
  description="Creators of Aster Lang, VaadinCKEditor, and Aster Cloud. Open-source developer tools, programming language design, and cloud-native infrastructure by wontlost."
>
  <Header />
  <main>
    <HeroSection />
    <TrustBar />
    <Products />
    <ServicesGrid />
    <CaseStudy />
    <WhyChooseUs />
    <TechStack />
    <Testimonials />
    <Process />
    <CTASection />
  </main>
  <Footer />
</BaseLayout>
