---
import '../styles/global.css';
import '../styles/cookieconsent-overrides.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="wontlost" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <!-- Cookie Consent -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.css" />

    <title>{title}</title>

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "wontlost",
      "url": "https://wontlost.com",
      "description": "Developer tools, programming language design, and cloud-native infrastructure. Creators of Aster Lang, VaadinCKEditor, and Aster Cloud.",
      "sameAs": [
        "https://github.com/wontlost-ltd",
        "https://vaadin.com/directory/component/ckeditorvaadin",
        "https://aster-lang.cloud"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "service@wontlost.com"
      }
    })} />

    <!-- Cookie Consent JS -->
    <script is:inline defer src="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.umd.js"></script>
    <script is:inline>
      var GA4_ID = 'G-ND0GXVBBWK';

      function setGAConsent(granted) {
        window['ga-disable-' + GA4_ID] = !granted;
        if (window.gtag) {
          window.gtag('consent', 'update', {
            analytics_storage: granted ? 'granted' : 'denied'
          });
        }
      }

      function handleAnalyticsConsent() {
        if (CookieConsent.acceptedCategory('analytics')) {
          setGAConsent(true);
          loadGA4();
        } else {
          setGAConsent(false);
        }
      }

      function loadGA4() {
        if (window._ga4Loaded) return;
        window._ga4Loaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = window.gtag || gtag;
        gtag('js', new Date());
        gtag('config', GA4_ID);
      }

      window.addEventListener('load', function() {
        if (typeof CookieConsent === 'undefined') return;

        CookieConsent.run({
          guiOptions: {
            consentModal: { layout: 'bar inline', position: 'bottom', equalWeightButtons: false },
            preferencesModal: { layout: 'box' }
          },

          categories: {
            necessary: { enabled: true, readOnly: true },
            analytics: {
              autoClear: {
                cookies: [{ name: /^_ga/ }, { name: '_gid' }]
              }
            }
          },

          onFirstConsent: handleAnalyticsConsent,
          onConsent: handleAnalyticsConsent,
          onChange: handleAnalyticsConsent,

          language: {
            default: 'en',
            translations: {
              en: {
                consentModal: {
                  description: 'We use cookies to analyze site traffic and improve your experience.',
                  acceptAllBtn: 'Accept All',
                  acceptNecessaryBtn: 'Reject All',
                  showPreferencesBtn: 'Manage'
                },
                preferencesModal: {
                  title: 'Cookie Preferences',
                  acceptAllBtn: 'Accept All',
                  acceptNecessaryBtn: 'Reject All',
                  savePreferencesBtn: 'Save Preferences',
                  sections: [
                    { title: 'Essential Cookies', description: 'Required for the site to function properly.', linkedCategory: 'necessary' },
                    { title: 'Analytics Cookies', description: 'Help us understand how visitors use the site via Google Analytics.', linkedCategory: 'analytics' }
                  ]
                }
              }
            }
          }
        });
      });
    </script>
  </head>
  <body class="bg-white text-gray-800 font-body">
    <slot />
  </body>
</html>
