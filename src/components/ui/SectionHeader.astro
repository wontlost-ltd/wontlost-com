---
interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  light?: boolean;
}

const { title, subtitle, centered = true, light = false } = Astro.props;
---

<div class:list={[centered && 'text-center', 'mb-12 lg:mb-16']}>
  <h2 class:list={[
    'text-3xl sm:text-4xl font-heading font-bold tracking-tight',
    light ? 'text-white' : 'text-gray-900',
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      'mt-4 text-lg max-w-2xl',
      centered && 'mx-auto',
      light ? 'text-gray-300' : 'text-gray-600',
    ]}>
      {subtitle}
    </p>
  )}
</div>
