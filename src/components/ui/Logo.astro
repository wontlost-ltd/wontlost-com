---
/**
 * wontlost 标志 —— 仙后座（Cassiopeia）：天上的 "W"，也是用来找北极星的星座。
 * 透明背景的浮雕版，立体感由 SVG 原生滤镜（feDropShadow）实现，随尺寸等比缩放。
 *
 * theme:
 *   - "light"  用在浅色背景上（默认，当前站点的页头）
 *   - "dark"   用在深色背景上（页脚 bg-gray-900）
 *   - "auto"   同时输出两套，跟随祖先元素上的 `.dark` class 切换
 *              （将来给站点加 class 策略的深色模式时，页头直接改成 auto 即可）
 */
interface Props {
  theme?: 'light' | 'dark' | 'auto';
  class?: string;
  /** 提供则作为可访问名称；不提供则视为装饰（旁边已有 "wontlost" 文字时） */
  title?: string;
}

const { theme = 'light', class: className = '', title } = Astro.props;

const palettes = {
  light: {
    line: '#60a5fa', lineHi: 0.6, dot: '#2563eb', dotHi: 0.55, star: '#06b6d4',
    lineFx: [{ dx: 0.4, dy: 0.8, sd: 0.25, c: '#1e40af', o: 0.35 }],
    dotFx: [{ dx: 0.6, dy: 1.1, sd: 0.4, c: '#1e40af', o: 0.42 }],
    starFx: [{ dx: 0.8, dy: 1.4, sd: 0.5, c: '#08506e', o: 0.4 }],
  },
  dark: {
    line: '#3b82f6', lineHi: 0.35, dot: '#dbeafe', dotHi: 0.9, star: '#67e8f9',
    lineFx: [{ dx: 0, dy: 0.8, sd: 0.3, c: '#000000', o: 0.6 }],
    dotFx: [
      { dx: 0, dy: 0, sd: 0.9, c: '#60a5fa', o: 0.9 },
      { dx: 0.5, dy: 1, sd: 0.35, c: '#000000', o: 0.6 },
    ],
    starFx: [
      { dx: 0, dy: 0, sd: 1.3, c: '#67e8f9', o: 0.9 },
      { dx: 0.6, dy: 1.1, sd: 0.4, c: '#000000', o: 0.6 },
    ],
  },
} as const;

const LINE = 'M7 22L19 46L27.5 33.6M36.7 33.5L45 45L57 18';
const DOTS = [
  { x: 7, y: 22, r: 4 },
  { x: 19, y: 46, r: 4.6 },
  { x: 45, y: 45, r: 4.2 },
  { x: 57, y: 18, r: 3.6 },
];
const STAR = 'M32 17Q34 25 42 27Q34 29 32 37Q30 29 22 27Q30 25 32 17Z';

const uid = Math.random().toString(36).slice(2, 8);
const variants = theme === 'auto' ? (['light', 'dark'] as const) : ([theme] as const);
const r2 = (n: number) => Math.round(n * 100) / 100;
---

{variants.map((v) => {
  const p = palettes[v];
  const id = (part: string) => `wl-${uid}-${v}-${part}`;
  const layers = [
    { key: 'line', fx: p.lineFx },
    { key: 'dot', fx: p.dotFx },
    { key: 'star', fx: p.starFx },
  ];
  return (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="1 12 62 41"
      class:list={[
        'wl-logo',
        theme === 'auto' && `wl-logo--auto-${v}`,
        className,
      ]}
      role={title ? 'img' : undefined}
      aria-label={title}
      aria-hidden={title ? undefined : 'true'}
      overflow="visible"
    >
      <defs>
        {layers.map((l) => (
          <filter id={id(l.key)} x="-6" y="4" width="76" height="58" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
            {l.fx.map((f) => (
              <feDropShadow dx={f.dx} dy={f.dy} stdDeviation={f.sd} flood-color={f.c} flood-opacity={f.o} />
            ))}
          </filter>
        ))}
      </defs>

      <g filter={`url(#${id('line')})`} fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d={LINE} stroke={p.line} stroke-width="2.6" />
        <path d={LINE} stroke="#fff" stroke-opacity={p.lineHi} stroke-width="0.7" transform="translate(-0.45 -0.45)" />
      </g>

      <g filter={`url(#${id('dot')})`}>
        {DOTS.map((d) => (
          <>
            <circle cx={d.x} cy={d.y} r={d.r} fill={p.dot} />
            <circle cx={r2(d.x - d.r * 0.28)} cy={r2(d.y - d.r * 0.32)} r={r2(d.r * 0.42)} fill="#fff" fill-opacity={p.dotHi} />
          </>
        ))}
      </g>

      <g filter={`url(#${id('star')})`}>
        <path d={STAR} fill={p.star} />
        <path d="M32 27L32 17Q30 25 22 27Z" fill="#fff" fill-opacity="0.5" />
        <path d="M32 27L32 37Q34 29 42 27Z" fill="#000" fill-opacity="0.2" />
      </g>
    </svg>
  );
})}

<style is:global>
  .wl-logo { display: block; flex-shrink: 0; }
  .wl-logo--auto-dark { display: none; }
  .dark .wl-logo--auto-light { display: none; }
  .dark .wl-logo--auto-dark { display: block; }
</style>
