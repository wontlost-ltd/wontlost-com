---
interface Props {
  icon: string;
  title: string;
  description: string;
  href: string;
}

const { icon, title, description, href } = Astro.props;
---

<div class="group relative bg-white rounded-xl p-6 lg:p-8 shadow-sm border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
  <div class="inline-flex items-center justify-center w-14 h-14 rounded-lg bg-primary-50 text-primary-500 mb-5 group-hover:bg-primary-500 group-hover:text-white transition-colors duration-300">
    <Fragment set:html={icon} />
  </div>
  <h3 class="text-xl font-heading font-semibold text-gray-900 mb-3">{title}</h3>
  <p class="text-gray-600 leading-relaxed mb-4">{description}</p>
  <a
    href={href}
    class="inline-flex items-center text-primary-500 font-medium text-sm hover:text-primary-600 transition-colors"
  >
    Learn more
    <svg class="ml-1 w-4 h-4 group-hover:translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
    </svg>
  </a>
</div>
