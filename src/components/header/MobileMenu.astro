---
import type { NavItem } from '../../types';

interface Props {
  navItems: NavItem[];
}

const { navItems } = Astro.props;
---

<!-- CSS-only 移动菜单（checkbox hack，零JS） -->
<div class="lg:hidden">
  <input type="checkbox" id="mobile-menu-toggle" class="peer sr-only" />

  <!-- 汉堡按钮 -->
  <label
    for="mobile-menu-toggle"
    class="relative z-50 flex flex-col justify-center items-center w-10 h-10 cursor-pointer"
    aria-label="Toggle menu"
  >
    <span class="block w-5 h-0.5 bg-gray-700 transition-all duration-300 peer-checked:translate-y-[3px] peer-checked:rotate-45"></span>
    <span class="block w-5 h-0.5 bg-gray-700 mt-1 transition-all duration-300 peer-checked:opacity-0"></span>
    <span class="block w-5 h-0.5 bg-gray-700 mt-1 transition-all duration-300 peer-checked:-translate-y-[3px] peer-checked:-rotate-45"></span>
  </label>

  <!-- 背景遮罩 -->
  <div class="fixed inset-0 bg-black/50 z-40 opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity duration-300">
    <label for="mobile-menu-toggle" class="block w-full h-full"></label>
  </div>

  <!-- 菜单面板 -->
  <div class="fixed top-0 right-0 bottom-0 w-72 bg-white z-40 shadow-2xl translate-x-full peer-checked:translate-x-0 transition-transform duration-300">
    <div class="pt-20 px-6">
      <nav class="flex flex-col gap-1">
        {navItems.map((item) => (
          <label for="mobile-menu-toggle">
            <a
              href={item.href}
              class="block px-4 py-3 text-gray-700 hover:text-primary-500 hover:bg-primary-50 rounded-lg font-medium transition-colors"
            >
              {item.label}
            </a>
          </label>
        ))}
      </nav>
      <div class="mt-6 pt-6 border-t border-gray-100">
        <label for="mobile-menu-toggle">
          <a
            href="#contact"
            class="block w-full text-center px-5 py-3 bg-primary-500 text-white font-heading font-semibold rounded-lg hover:bg-primary-600 transition-colors"
          >
            Get Started
          </a>
        </label>
      </div>
    </div>
  </div>
</div>

<style>
  /* 利用 peer 选择器控制汉堡动画 */
  #mobile-menu-toggle:checked ~ label span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #mobile-menu-toggle:checked ~ label span:nth-child(2) {
    opacity: 0;
  }
  #mobile-menu-toggle:checked ~ label span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
