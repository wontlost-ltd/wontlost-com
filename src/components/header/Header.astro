---
import Container from '../ui/Container.astro';
import MobileMenu from './MobileMenu.astro';
import { mainNav } from '../../data/navigation';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <Container>
    <nav class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div class="w-8 h-8 bg-primary-500 rounded-lg flex items-center justify-center">
          <span class="text-white font-heading font-bold text-sm">W</span>
        </div>
        <span class="font-heading font-bold text-xl text-gray-900">wontlost</span>
      </a>

      <!-- 桌面端导航 -->
      <div class="hidden lg:flex items-center gap-8">
        {mainNav.map((item) => (
          <a
            href={item.href}
            class="text-gray-600 hover:text-primary-500 font-medium text-sm transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- 桌面端 CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a
          href="#contact"
          class="inline-flex items-center justify-center px-5 py-2.5 bg-primary-500 text-white font-heading font-semibold text-sm rounded-lg hover:bg-primary-600 transition-colors shadow-sm"
        >
          Get Started
        </a>
      </div>

      <!-- 移动端菜单触发器 -->
      <MobileMenu navItems={mainNav} />
    </nav>
  </Container>
</header>

<!-- 为固定导航预留空间 -->
<div class="h-16 lg:h-20"></div>
