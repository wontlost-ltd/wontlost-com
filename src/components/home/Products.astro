---
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { products } from '../../data/products';
---

<section id="products" class="section-padding section-bg-alt">
  <Container>
    <SectionHeader
      title="Our Products"
      subtitle="Open-source tools and commercial platforms built by wontlost, used by developers and enterprises worldwide."
    />

    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {products.map((product) => (
        <a
          href={product.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-xl p-6 lg:p-8 border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
        >
          <div class="flex items-start gap-4 mb-4">
            <div class="shrink-0 w-14 h-14 rounded-xl bg-primary-50 text-primary-500 flex items-center justify-center group-hover:bg-primary-500 group-hover:text-white transition-colors duration-300">
              <Fragment set:html={product.icon} />
            </div>
            <div>
              <h3 class="text-xl font-heading font-bold text-gray-900 group-hover:text-primary-500 transition-colors">
                {product.name}
              </h3>
              <p class="text-sm text-primary-500 font-medium">
                {product.tagline}
              </p>
            </div>
          </div>

          <p class="text-gray-600 leading-relaxed mb-5">
            {product.description}
          </p>

          <div class="flex flex-wrap gap-2">
            {product.badges.map((badge) => (
              <span class="px-2.5 py-1 bg-gray-50 text-gray-600 text-xs font-medium rounded-md border border-gray-100">
                {badge}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
