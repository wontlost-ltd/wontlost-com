---
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { techCategories } from '../../data/technologies';
---

<section id="tech-stack" class="section-padding section-bg-alt">
  <Container>
    <SectionHeader
      title="Our Tech Stack"
      subtitle="We leverage industry-leading technologies to build robust, scalable, and future-proof solutions."
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {techCategories.map((category) => (
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <h3 class="font-heading font-semibold text-gray-900 mb-4 text-sm uppercase tracking-wider">
            {category.name}
          </h3>
          <div class="grid grid-cols-2 gap-3">
            {category.items.map((tech) => (
              <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-lg text-sm text-gray-700 font-medium hover:bg-primary-50 hover:text-primary-600 transition-colors">
                <div class="w-2 h-2 rounded-full bg-primary-400"></div>
                {tech}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
