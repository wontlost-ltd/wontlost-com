---
import Container from '../ui/Container.astro';
import { stats } from '../../data/services';
---

<section class="section-bg-alt">
  <Container>
    <div class="py-12 lg:py-16">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold text-primary-500">
              {stat.value}
            </div>
            <div class="mt-2 text-sm sm:text-base text-gray-600 font-medium">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
