---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden bg-gradient-to-br from-white via-primary-50/30 to-white">
  <Container>
    <div class="section-padding">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- 文字区域 -->
        <div class="animate-fade-in-up">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary-50 text-primary-600 text-sm font-medium rounded-full mb-6">
            <span class="w-1.5 h-1.5 bg-primary-500 rounded-full"></span>
            Developer tools & cloud platforms by wontlost
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold text-gray-900 tracking-tight leading-tight">
            We Build Tools
            <span class="text-primary-500"> Developers Love</span>
          </h1>

          <p class="mt-6 text-lg text-gray-600 leading-relaxed max-w-lg">
            From the Aster programming language to the top-rated VaadinCKEditor, we create open-source libraries, cloud platforms, and developer tools that solve real problems.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <Button href="#products" variant="primary" size="lg">
              Explore Products
            </Button>
            <Button href="https://aster-lang.cloud/" variant="secondary" size="lg">
              Try Aster Cloud
            </Button>
          </div>

          <!-- 信任徽章 -->
          <div class="mt-10 flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-gray-500">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Maven Central
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Vaadin Directory
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              npm Registry
            </div>
          </div>
        </div>

        <!-- 右侧多语言代码示例卡片（3s 自动切换） -->
        <div class="relative animate-fade-in-up-delay-1 hidden lg:block" id="hero-code-carousel">
          <div class="relative w-full aspect-square max-w-lg mx-auto">
            <div class="absolute inset-0 bg-gradient-to-br from-primary-100 to-primary-50 rounded-3xl rotate-3"></div>
            <div class="absolute inset-0 bg-white rounded-3xl shadow-xl border border-gray-100 -rotate-1">
              <div class="p-8 h-full flex flex-col justify-center">
                <!-- 窗口控制按钮 -->
                <div class="flex gap-2 mb-4">
                  <div class="w-3 h-3 rounded-full bg-red-400"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                  <div class="w-3 h-3 rounded-full bg-green-400"></div>
                </div>

                <!-- 语言标签切换 -->
                <div class="flex gap-2 mb-4">
                  <button data-lang="0" class="hero-lang-tab px-3 py-1 text-xs font-mono rounded-md bg-primary-50 text-primary-600 font-medium transition-colors">English</button>
                  <button data-lang="1" class="hero-lang-tab px-3 py-1 text-xs font-mono rounded-md bg-gray-100 text-gray-500 transition-colors">中文</button>
                  <button data-lang="2" class="hero-lang-tab px-3 py-1 text-xs font-mono rounded-md bg-gray-100 text-gray-500 transition-colors">Deutsch</button>
                </div>

                <!-- 代码卡片容器 -->
                <div class="relative flex-1 min-h-0">
                  <!-- English -->
                  <div class="hero-code-card absolute inset-0 transition-all duration-500 opacity-100 translate-y-0" data-index="0">
                    <div class="text-xs text-gray-400 mb-3 font-mono">policy.aster <span class="text-primary-400">— English</span></div>
                    <div class="space-y-2 font-mono text-sm">
                      <div><span class="text-purple-600">Define</span> <span class="text-gray-800">User</span> <span class="text-purple-600">with</span> <span class="text-gray-600">name, email, role.</span></div>
                      <div class="h-1.5"></div>
                      <div><span class="text-purple-600">To</span> <span class="text-blue-600">check access</span> <span class="text-purple-600">with</span> <span class="text-gray-600">user:</span></div>
                      <div class="pl-4"><span class="text-purple-600">If</span> <span class="text-gray-800">user.role</span> <span class="text-purple-600">is</span> <span class="text-green-600">"admin"</span><span class="text-gray-400">:</span></div>
                      <div class="pl-8"><span class="text-purple-600">Return</span> <span class="text-amber-600">true</span><span class="text-gray-400">.</span></div>
                      <div class="pl-4"><span class="text-purple-600">Otherwise</span><span class="text-gray-400">:</span></div>
                      <div class="pl-8"><span class="text-purple-600">Return</span> <span class="text-amber-600">false</span><span class="text-gray-400">.</span></div>
                    </div>
                  </div>

                  <!-- 中文 -->
                  <div class="hero-code-card absolute inset-0 transition-all duration-500 opacity-0 translate-y-4 pointer-events-none" data-index="1">
                    <div class="text-xs text-gray-400 mb-3 font-mono">policy.aster <span class="text-primary-400">— 中文</span></div>
                    <div class="space-y-2 font-mono text-sm">
                      <div><span class="text-purple-600">定义</span> <span class="text-gray-800">用户</span> <span class="text-purple-600">包含</span> <span class="text-gray-600">姓名、邮箱、角色。</span></div>
                      <div class="h-1.5"></div>
                      <div><span class="text-purple-600">要</span> <span class="text-blue-600">检查权限</span> <span class="text-purple-600">使用</span> <span class="text-gray-600">用户：</span></div>
                      <div class="pl-4"><span class="text-purple-600">如果</span> <span class="text-gray-800">用户.角色</span> <span class="text-purple-600">是</span> <span class="text-green-600">"管理员"</span><span class="text-gray-400">：</span></div>
                      <div class="pl-8"><span class="text-purple-600">返回</span> <span class="text-amber-600">真</span><span class="text-gray-400">。</span></div>
                      <div class="pl-4"><span class="text-purple-600">否则</span><span class="text-gray-400">：</span></div>
                      <div class="pl-8"><span class="text-purple-600">返回</span> <span class="text-amber-600">假</span><span class="text-gray-400">。</span></div>
                    </div>
                  </div>

                  <!-- Deutsch -->
                  <div class="hero-code-card absolute inset-0 transition-all duration-500 opacity-0 translate-y-4 pointer-events-none" data-index="2">
                    <div class="text-xs text-gray-400 mb-3 font-mono">policy.aster <span class="text-primary-400">— Deutsch</span></div>
                    <div class="space-y-2 font-mono text-sm">
                      <div><span class="text-purple-600">Definiere</span> <span class="text-gray-800">Benutzer</span> <span class="text-purple-600">mit</span> <span class="text-gray-600">Name, E-Mail, Rolle.</span></div>
                      <div class="h-1.5"></div>
                      <div><span class="text-purple-600">Um</span> <span class="text-blue-600">Zugriff zu prüfen</span> <span class="text-purple-600">mit</span> <span class="text-gray-600">Benutzer:</span></div>
                      <div class="pl-4"><span class="text-purple-600">Wenn</span> <span class="text-gray-800">Benutzer.Rolle</span> <span class="text-purple-600">ist</span> <span class="text-green-600">"Admin"</span><span class="text-gray-400">:</span></div>
                      <div class="pl-8"><span class="text-purple-600">Rückgabe</span> <span class="text-amber-600">wahr</span><span class="text-gray-400">.</span></div>
                      <div class="pl-4"><span class="text-purple-600">Sonst</span><span class="text-gray-400">:</span></div>
                      <div class="pl-8"><span class="text-purple-600">Rückgabe</span> <span class="text-amber-600">falsch</span><span class="text-gray-400">.</span></div>
                    </div>
                  </div>
                </div>

                <!-- 标签徽章 -->
                <div class="mt-4 flex gap-3">
                  <div class="px-3 py-1.5 bg-green-50 text-green-700 text-xs font-medium rounded-full">Type-Safe</div>
                  <div class="px-3 py-1.5 bg-primary-50 text-primary-700 text-xs font-medium rounded-full">Human-Readable</div>
                  <div class="px-3 py-1.5 bg-purple-50 text-purple-700 text-xs font-medium rounded-full">Multi-Language</div>
                </div>

                <!-- 进度条指示器 -->
                <div class="mt-3 flex gap-1.5">
                  <div class="hero-progress-dot h-1 rounded-full bg-primary-500 transition-all duration-300 w-8"></div>
                  <div class="hero-progress-dot h-1 rounded-full bg-gray-200 transition-all duration-300 w-4"></div>
                  <div class="hero-progress-dot h-1 rounded-full bg-gray-200 transition-all duration-300 w-4"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <script>
          const carousel = document.getElementById('hero-code-carousel');
          if (carousel) {
            const cards = carousel.querySelectorAll('.hero-code-card');
            const tabs = carousel.querySelectorAll('.hero-lang-tab');
            const dots = carousel.querySelectorAll('.hero-progress-dot');
            const total = cards.length;
            let current = 0;
            let timer: ReturnType<typeof setInterval>;

            function show(index: number) {
              current = index;
              cards.forEach((card, i) => {
                const el = card as HTMLElement;
                if (i === index) {
                  el.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
                  el.classList.add('opacity-100', 'translate-y-0');
                } else {
                  el.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
                  el.classList.remove('opacity-100', 'translate-y-0');
                }
              });
              tabs.forEach((tab, i) => {
                if (i === index) {
                  tab.classList.remove('bg-gray-100', 'text-gray-500');
                  tab.classList.add('bg-primary-50', 'text-primary-600', 'font-medium');
                } else {
                  tab.classList.add('bg-gray-100', 'text-gray-500');
                  tab.classList.remove('bg-primary-50', 'text-primary-600', 'font-medium');
                }
              });
              dots.forEach((dot, i) => {
                if (i === index) {
                  dot.classList.remove('bg-gray-200', 'w-4');
                  dot.classList.add('bg-primary-500', 'w-8');
                } else {
                  dot.classList.add('bg-gray-200', 'w-4');
                  dot.classList.remove('bg-primary-500', 'w-8');
                }
              });
            }

            function startTimer() {
              timer = setInterval(() => show((current + 1) % total), 3000);
            }

            tabs.forEach((tab) => {
              tab.addEventListener('click', () => {
                clearInterval(timer);
                show(Number((tab as HTMLElement).dataset.lang));
                startTimer();
              });
            });

            startTimer();
          }
        </script>
      </div>
    </div>
  </Container>
</section>
